# STORY-0.2 — Required environment variables for Docker Compose
# Copy to .env and set real values. Never commit .env.

# --- Postgres ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-secure-password

# --- Keycloak ---
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=change-me-admin-password
KC_HTTP_PORT=8080
